{
  "id": "bg3-flow",
  "title": "BG3 Flow",
  "description": "Baldur's Gate 3 style combat flow for dnd5e: fully automatic Midi QOL preset, friend-or-foe area targeting, shared ally turns, movement lock and budget, stealth-based encounters.",
  "version": "0.6.0",
  "authors": [{ "name": "Emilio Nava" }],
  "compatibility": { "minimum": "14", "verified": "14" },
  "esmodules": ["scripts/main.js"],
  "socket": true,
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "es", "name": "Español", "path": "lang/es.json" }
  ],
  "relationships": {
    "systems": [{ "id": "dnd5e", "type": "system", "compatibility": { "minimum": "6.0", "maximum": "6.0.999" } }],
    "requires": [
      { "id": "midi-qol", "type": "module", "compatibility": { "minimum": "14.6" } },
      { "id": "lib-wrapper", "type": "module" },
      { "id": "socketlib", "type": "module" }
    ]
  },
  "url": "https://github.com/godofred2/bg3-flow",
  "manifest": "https://github.com/godofred2/bg3-flow/releases/latest/download/module.json",
  "download": "https://github.com/godofred2/bg3-flow/releases/latest/download/module.zip"
}
